// Cati Forms database. Forms, questions, responses and answers are separate
// tables linked by foreign keys (RF12, RF13, RNF08). Ids are generated by the
// app (random base64url), since a form's id is part of its public link (RF08).
//
// After changing this file: `make db-migrate name=<what changed>`.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum QuestionType {
  text
  multiple_choice
  single_choice
  single_choice_justified

  @@map("question_type")
}

/// People who create and read forms (RF01, RF02, RN03). Respondents are not
/// users: they answer through the link, without an account (RN09).
model User {
  id           String   @id
  /// As typed at sign-up, for display.
  username     String
  /// Lowercased username, so "Admin" and "admin" are the same user (RN01).
  usernameKey  String   @unique @map("username_key")
  /// scrypt hash, never the password (RNF05).
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  forms        Form[]

  @@map("users")
}

// Nothing is ever deleted (RN07), so every relation restricts deletes.

model Form {
  id           String     @id
  title        String
  description  String
  /// Whether respondents must give a contact e-mail (RF07, RN08).
  collectEmail Boolean    @map("collect_email")
  authorId     String     @map("author_id")
  author       User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  questions    Question[]
  responses    Response[]

  @@index([createdAt])
  @@map("forms")
}

model Question {
  id       String       @id
  formId   String       @map("form_id")
  form     Form         @relation(fields: [formId], references: [id], onDelete: Restrict)
  /// Order within the form, starting at 0.
  position Int
  type     QuestionType
  title    String
  /// Empty for text questions. Forms can't be edited (RN07), so answers can
  /// refer to options by their text.
  options  String[]     @default([])
  answers  Answer[]

  @@unique([formId, position])
  @@map("questions")
}

/// One submission through the form's link, anonymous (RF09, RN09).
model Response {
  id          String   @id
  formId      String   @map("form_id")
  form        Form     @relation(fields: [formId], references: [id], onDelete: Restrict)
  /// Only stored when the form asks for it (RN08).
  email       String?
  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)
  answers     Answer[]

  @@index([formId, submittedAt])
  @@map("responses")
}

model Answer {
  id         String   @id
  responseId String   @map("response_id")
  response   Response @relation(fields: [responseId], references: [id], onDelete: Restrict)
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  /// Selected options: exactly one for single choice, at least one for
  /// multiple choice (RN06), none for text.
  choices    String[] @default([])
  /// The written answer or, for single choice, the justification (RN05).
  text       String

  /// One answer per question in each response.
  @@unique([responseId, questionId])
  @@map("answers")
}
