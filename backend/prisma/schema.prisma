// After changing this file: `make db-migrate name=<what changed>`.

// Banco de Dados do Cati Forms
// Formulários, perguntas, respostas do formulário, e respostas individuais
// são todos armazenados de forma independente e relacionados uns com os outros.
// (RF12, RF13, RNF08)
// Ids são gerados com um script simples no backend. (RF08)

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

// o PostgreSQL foi escolhido como o banco de dados da aplicação
datasource db {
  provider = "postgresql"
}

// diferentes tipos de perguntas que pode ter em um formulário
enum QuestionType {
  text
  multiple_choice
  single_choice
  single_choice_justified

  @@map("question_type")
}

/// modelo do Usuário que se cadastra na plataforma (RF01, RF02, RN03)
/// respondentes não precisam de cadastro (RN09)
model User {
  /// id único gerado para o usuário
  id           String   @id
  /// nome da forma que foi digitado (usado para display)
  username     String
  /// nome real e usado como parametro no diminutivo (RN01).
  usernameKey  String   @unique @map("username_key")
  /// hash da senha, nunca a senha em si (RNF05)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  forms        Form[]

  @@map("users")
}

// Nada é deletado atualmente, então as relações restringem deleção (RN07)

model Form {
  id           String     @id
  title        String
  description  String
  /// booleano se o formulário deve coletar o email do usuário ou não (RF07, RN08)
  collectEmail Boolean    @map("collect_email")
  authorId     String     @map("author_id")
  author       User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  questions    Question[]
  responses    Response[]

  @@index([createdAt])
  @@map("forms")
}

model Question {
  id       String       @id
  formId   String       @map("form_id")
  form     Form         @relation(fields: [formId], references: [id], onDelete: Restrict)
  /// em que posição a pergunta se encontra no formulário, começando em 0
  position Int
  type     QuestionType
  title    String
  /// vazio para perguntas de escrita formulários
  options  String[]     @default([])
  answers  Answer[]

  @@unique([formId, position])
  @@map("questions")
}

/// uma submissão pelo link do forms, anonimamente (RF09, RN09)
model Response {
  id          String   @id
  formId      String   @map("form_id")
  form        Form     @relation(fields: [formId], references: [id], onDelete: Restrict)
  /// só guardar email se o formulário perguntar por isso (RN08)
  email       String?
  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)
  answers     Answer[]

  @@index([formId, submittedAt])
  @@map("responses")
}

model Answer {
  id         String   @id
  responseId String   @map("response_id")
  response   Response @relation(fields: [responseId], references: [id], onDelete: Restrict)
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  /// opções selecionados, apenas uma em single_choice, pelo menos uma em multiple_choice
  choices    String[] @default([])
  /// resposta escrita para single_choice_justified e text (RN05).
  text       String

  /// uma respostas por questão em cada formulário respondido
  @@unique([responseId, questionId])
  @@map("answers")
}
